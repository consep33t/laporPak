generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Laporan {
  id          String   @id @default(cuid())
  name        String
  email       String
  imageUrl    String
  location    String
  date        String
  description String
}
